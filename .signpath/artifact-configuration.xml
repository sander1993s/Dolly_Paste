<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <!-- GitHub's upload-artifact wraps the single executable in a ZIP archive. -->
  <zip-file>
    <pe-file path="Dolly Paste.exe" product-name="Dolly Paste"
             company-name="Smet Software Solutions"
             product-version="${version}" file-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
